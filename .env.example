# Never commit real credentials. Aegis reads secrets only from the environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AEGIS_ADMIN_TOKEN=change-this-in-production
AEGIS_DATABASE_PATH=data/aegis.db
AEGIS_MODEL_CATALOG_PATH=configs/models.yaml
AEGIS_OLLAMA_BASE_URL=http://localhost:11434
AEGIS_LOG_LEVEL=INFO
AEGIS_ENABLE_CONSOLE=true
